# deploy/.env.example
# 复制为 deploy/.env 后按需修改：
#   cp deploy/.env.example deploy/.env
#
# 用在这份 stack 上：
#   docker compose -f deploy/docker-compose.stack.yml --env-file deploy/.env up -d --build

# ---------------------------------------------------------------------------
# API 鉴权 key —— 前端/脚本访问 /api/* 时通过 x-api-key 或 Bearer 携带
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
API_KEY=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Token 加密主密钥 —— 32 字节的 base64
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 警告：这个值丢失 = 数据库里所有 token_enc 永久无法解密。
#       至少在两处离线备份；轮换时改 TOKEN_KEY_ID 并跑 backfill 重加密。
# ---------------------------------------------------------------------------
TOKEN_MASTER_KEY=change-me-to-base64-of-32-bytes
TOKEN_KEY_ID=k1

# ---------------------------------------------------------------------------
# 数据库
# 默认用 stack 内置的 db 服务；改用托管 Postgres 时覆盖下面两项。
#
# 重要：worker 必须能建立「会话级」连接，否则 advisory lock 失效。
#   - Supabase transaction pooler（6543）不支持会话级锁 → worker 用 5432
#   - 自建 / RDS / 直连 5432 正常
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://xyzw:xyzw_dev_pw@db:5432/xyzw
# WORKER_DATABASE_URL=postgresql://xyzw:xyzw_dev_pw@db:5432/xyzw

POSTGRES_USER=xyzw
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=xyzw

# ---------------------------------------------------------------------------
# 运行参数
# ---------------------------------------------------------------------------

# 单个任务内同时连几个角色。别调高：同一出口 IP 并发越高越容易触发游戏服风控。
MAX_CONCURRENT_TOKENS=2

# api 连接池大小
DB_POOL_MAX=10
# worker 连接池大小（单实例，够用即可）
WORKER_DB_POOL_MAX=5

# 内存日志条数上限（GET /api/logs 的可见窗口）
LOG_MAX=500
