# ============================================================================
# XYZW Web Helper — Git 忽略规则
# 原则：
#   1) 依赖 / 构建产物 / 缓存 / 日志不入库（体积大、可重建）
#   2) 纯前端项目，凭证（游戏 Token、bin 文件）只属于本机，绝不入库
#   3) 文档必须入库（README / CHANGELOG / AGENTS / CLAUDE / docs / design-system），
#      因此这里不再使用 `*.md` 这种全量忽略，只忽略本地草稿
# ============================================================================

# ---------------------------------------------------------------- 依赖 / 包管理
node_modules/
jspm_packages/
.pnpm-store/
.npm/
.yarn/
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/sdks
.yarn-integrity
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
*.tgz

# ---------------------------------------------------------------- 构建产物 / 缓存
dist/
dist-ssr/
dist-*/
release/
.vite/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.nuxt/
.next/
.serverless/
coverage/
.nyc_output/
*.tsbuildinfo
*.local
*.local.*

# ---------------------------------------------------------------- 日志 / 临时文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids
*.pid
*.seed
*.pid.lock
.node_repl_history
*.swp
*.swo
*.ntvs*
*.njsproj
*.sln
*.suo

# ---------------------------------------------------------------- 环境变量 / 本地配置
.env
.env.*
!.env.example
.envrc
config.local.*
deploy/*.local.*
deploy/.env*

# ---------------------------------------------------------------- 敏感数据（Token / bin / 抓包）
# 游戏 Token、伏羲 bin、抓包数据一律不上传
xyzw_data/
*.bin
!public/game/**/*.bin
public/xyzw_token.bin
*.token
*.tokens
*.har

# ---------------------------------------------------------------- 本地草稿 / 探查脚本
scratch/
tmp/
temp/
*.draft.*
*.local.md
*-draft.md
docs/private/
docs/local/

# ---------------------------------------------------------------- 编辑器 / 系统
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.history/
*.code-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------------------------------------------------------------- 测试 / 覆盖率产物
test-results/
playwright-report/
screenshots/

# ---------------------------------------------------------------- 反向保险：文档与契约文件必须入库
!README.md
!CHANGELOG.md
!LICENSE
!AGENTS.md
!CLAUDE.md
!docs/**
!design-system/**
