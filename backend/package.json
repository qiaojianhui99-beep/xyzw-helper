{
  "name": "xyzw-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "XYZW Web Helper 后端：Fastify API + worker，Postgres 存储",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "shim": "node scripts/supabase-shim.js",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "fastify": "^5.12.8",
    "lz4js": "^0.2.0",
    "node-cron": "^3.0.3",
    "pg": "^8.23.1",
    "ws": "^8.22.2"
  }
}
